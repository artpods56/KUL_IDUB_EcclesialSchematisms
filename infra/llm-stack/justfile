set shell := ["bash", "--noprofile", "--norc", "-euo", "pipefail", "-c"]

compose := "docker compose --env-file /etc/llm-stack/llm-stack.env -f /opt/llm-stack/compose.yaml"

default:
    just --list

doctor:
    /opt/llm-stack/scripts/doctor.sh

up:
    {{ compose }} up -d

down:
    {{ compose }} down

restart:
    {{ compose }} down
    {{ compose }} up -d

pull:
    {{ compose }} pull

logs:
    {{ compose }} logs -f --tail=200

logs-service service:
    {{ compose }} logs -f --tail=200 {{ service }}

ps:
    {{ compose }} ps

test:
    /opt/llm-stack/scripts/test-chat.sh

test-ui:
    /opt/llm-stack/scripts/test-ui.sh

install-nginx:
    install -m 0644 /opt/llm-stack/nginx/00-ai-test.ihpan.edu.pl.conf /etc/nginx/conf.d/00-ai-test.ihpan.edu.pl.conf

nginx-test:
    nginx -t

nginx-reload:
    nginx -t
    systemctl reload nginx
