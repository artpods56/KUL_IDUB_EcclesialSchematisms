# Compose publishes the same-origin gateway on loopback only. Web and API stay
# on the internal Docker network. Prefect remains a separate loopback dashboard
# port for SSH-tunneled ops access.
NOTARIUS_BIND_ADDRESS=127.0.0.1
NOTARIUS_GATEWAY_PORT=8080
PREFECT_PORT=4200
# Uvicorn trusts forwarded headers from the configured Compose subnet because
# the gateway container receives a dynamic address within it. Keep the subnet
# and bridge gateway aligned; override both if they overlap another network.
NOTARIUS_DOCKER_SUBNET=172.30.0.0/24
NOTARIUS_DOCKER_GATEWAY=172.30.0.1
NOTARIUS_DOCKER_NETWORK=notarius-internal

# Exact operator-provided HTTPS origin registered with the OIDC provider.
# Include a port only when that separate TLS endpoint uses a non-default port.
NOTARIUS_PUBLIC_ORIGIN=https://notarius.example.com
NOTARIUS_CORS_ORIGINS=https://notarius.example.com

# Prefect runs as an internal Compose service. Its host port remains loopback
# only and is intended for SSH-tunneled dashboard access.
NOTARIUS_EXECUTION_BACKEND=prefect
NOTARIUS_MAP_MAX_CONCURRENCY=4
# Process-wide execution budget. Requests above this active count receive 429.
NOTARIUS_MAX_ACTIVE_EXECUTIONS=2
PREFECT_UI_API_URL=http://127.0.0.1:4200/api

# Generate an independent value for each key with: openssl rand -base64 32
# Back them up. Changing them makes existing encrypted secrets, login
# transactions, or collaboration digests unverifiable.
NOTARIUS_CREDENTIAL_ENCRYPTION_KEY=
NOTARIUS_COMMAND_HMAC_KEY=
NOTARIUS_COMMAND_HMAC_KEY_VERSION=1

# OIDC relying-party inputs. Issuer, client ID, and wrapping key are required.
NOTARIUS_OIDC_ISSUER=
NOTARIUS_OIDC_CLIENT_ID=
# Uncomment only for a confidential client; public PKCE clients leave it absent.
# NOTARIUS_OIDC_CLIENT_SECRET=
NOTARIUS_OIDC_ALLOWED_SIGNING_ALGORITHMS=["RS256"]
NOTARIUS_OIDC_AUTH_WRAPPING_KEY=
NOTARIUS_OIDC_AUTH_WRAPPING_KEY_VERSION=1

# This Docker-only name cannot collide with the local development database URL.
# SQLite and local artifact storage share the durable notarius-data volume.
NOTARIUS_DOCKER_DATABASE_URL=sqlite+aiosqlite:////data/workbench/notarius.sqlite3
NOTARIUS_STORAGE_BACKEND=local
NOTARIUS_STORAGE_BUCKET=workbench-artifacts
# Per-file limit (1-64 MiB); values above 64 MiB are rejected by API settings.
NOTARIUS_STAGED_UPLOAD_MAX_BYTES=67108864

# Optional provider configuration.
MISTRAL_API_KEY=
OPENAI_CUSTOM_HEADERS=

# Optional S3-compatible storage. Set NOTARIUS_STORAGE_BACKEND=s3 to use it.
NOTARIUS_S3_ENDPOINT_URL=
NOTARIUS_S3_REGION=us-east-1
NOTARIUS_S3_ACCESS_KEY_ID=
NOTARIUS_S3_SECRET_ACCESS_KEY=
NOTARIUS_S3_FORCE_PATH_STYLE=false
