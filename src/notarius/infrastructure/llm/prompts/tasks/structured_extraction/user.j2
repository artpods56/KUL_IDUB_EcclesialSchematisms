<PROMPT_VERSION>0.0.2</PROMPT_VERSION>
<USER_REQUEST>
    <INSTRUCTION>
        Analyze this ecclesiastical schematism page image and extract the structured information according to the system instructions.
        Extract text exactly as printed - do not normalize, translate, or expand abbreviations.
    </INSTRUCTION>

    {% if PREVIOUS_PAGE__CONTEXT %}
    <PREVIOUS_PAGE_CONTEXT>
        This page continues from a previous page. Use the following context:
        {% if PREVIOUS_PAGE__CONTEXT.active_deanery %}
        <ACTIVE_DEANERY>{{ PREVIOUS_PAGE__CONTEXT.active_deanery }}</ACTIVE_DEANERY>
        {% else %}
        <ACTIVE_DEANERY>null (no deanery was active at end of previous page)</ACTIVE_DEANERY>
        {% endif %}
        {% if PREVIOUS_PAGE__CONTEXT.last_page_number %}
        <LAST_PAGE_NUMBER>{{ PREVIOUS_PAGE__CONTEXT.last_page_number }}</LAST_PAGE_NUMBER>
        {% endif %}
        {% if PREVIOUS_PAGE__CONTEXT.summary %}
        <PREVIOUS_SUMMARY>{{ PREVIOUS_PAGE__CONTEXT.summary }}</PREVIOUS_SUMMARY>
        {% endif %}

        Apply the active deanery to any parishes appearing BEFORE a new deanery heading on this page.
    </PREVIOUS_PAGE_CONTEXT>
    {% else %}
    <PREVIOUS_PAGE_CONTEXT>
        This is the first page or no context is available. Set `deanery` to null for any parishes
        appearing before a visible deanery heading on this page.
    </PREVIOUS_PAGE_CONTEXT>
    {% endif %}

    {% if CURRENT_PAGE__PREDICTIONS %}
    <MODEL_HINTS source="layoutlmv3">
        Suggestions from a smaller model (verify against the page scan):
        {{ CURRENT_PAGE__PREDICTIONS }}
    </MODEL_HINTS>
    {% else %}
    <MODEL_HINTS>
        No model hints provided. Use your own analysis of the page scan.
    </MODEL_HINTS>
    {% endif %}

    {% if CURRENT_PAGE__TEXT %}
    <CURRENT_PAGE_TEXT>
        OCR text from the current page (use as auxiliary hint, verify against image):
        {{ CURRENT_PAGE__TEXT }}
    </CURRENT_PAGE_TEXT>
    {% endif %}

    {% if NEXT_PAGE__TEXT %}
    <NEXT_PAGE_TEXT>
        OCR text from the next page (use this to complete entries that start on the current page but are cut off):
        {{ NEXT_PAGE__TEXT }}
    </NEXT_PAGE_TEXT>
    {% endif %}

    <EXTRACTION_FOCUS>
        For each visible parish on the page, extract:
        - Page number (as printed on the scan)
        - Deanery (from visible heading or inherited context)
        - Parish name (exactly as printed)
        - Dedication (with Latin abbreviations like S., SS., B.M.V.)
        - Building material (Latin abbreviations like mur., lig.)

        IMPORTANT:
        - Only extract entries that START on this page. Ignore continuations from the previous page.
        - If an entry starts here but is cut off at the bottom, use NEXT_PAGE_TEXT to complete the Latin fields.
        - Strip list numbering from parish names (e.g., "2. Boniewo" → "Boniewo").
        - Output entries in PAGE VISUAL ORDER (not model hint order).
        - Extract exactly as printed - preserve abbreviations, do not expand or normalize.
    </EXTRACTION_FOCUS>

    <RESPONSE_FORMAT>
        Return only the JSON object as specified in OUTPUT_SCHEMA.
        Include a `context` object with:
        - `summary`: Brief description of this page with reference to previous context
        - `note`: ONLY populate if you have low confidence or the page needs human review (null otherwise)
        - `active_deanery`: The deanery active at end of this page
        - `last_page_number`: This page's number

        No additional text or markdown.
    </RESPONSE_FORMAT>
</USER_REQUEST>
