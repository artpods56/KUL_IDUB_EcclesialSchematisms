# Server-side only. Required when a graph uses the Mistral OCR node.
MISTRAL_API_KEY=

# API runtime
NOTARIUS_WORKSPACE=.notarius-artifacts/workbench
NOTARIUS_DATABASE_URL=sqlite+aiosqlite:///.notarius-artifacts/workbench/notarius.sqlite3
# Exact browser origin. Local Next.js proxies /api → API, so keep this on :3000.
NOTARIUS_PUBLIC_ORIGIN=http://localhost:3000
NOTARIUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP must disable Secure cookies; production Compose keeps the default.
NOTARIUS_AUTH_COOKIE_SECURE=false
# Maximum concurrent items in a Prefect-backed MAP invocation. Inline stays at 1.
NOTARIUS_MAP_MAX_CONCURRENCY=4
# Stable standard-base64 encoding of 32 random bytes. Required to configure or
# use write-only node secrets; generate once with: openssl rand -base64 32
NOTARIUS_CREDENTIAL_ENCRYPTION_KEY=
# Server-keyed HMAC material for collaboration command and execution digests.
# Required for API startup; generate once with: openssl rand -base64 32
NOTARIUS_COMMAND_HMAC_KEY=
NOTARIUS_COMMAND_HMAC_KEY_VERSION=1
# Collaboration assumes one API process/worker. Production Compose keeps this
# true and acquires an exclusive workspace lock at startup.
# NOTARIUS_REQUIRE_SINGLE_API_OWNER=true

# Local Keycloak (make keycloak-up). See infra/keycloak/README.md.
NOTARIUS_OIDC_ISSUER=http://keycloak.localhost:8081/realms/notarius
NOTARIUS_OIDC_CLIENT_ID=notarius-web
# Public PKCE client — leave secret unset for the imported notarius-web client.
# NOTARIUS_OIDC_CLIENT_SECRET=
NOTARIUS_OIDC_AUTH_WRAPPING_KEY=
NOTARIUS_OIDC_AUTH_WRAPPING_KEY_VERSION=1
# Fixed subject of the imported Keycloak user `owner` / `owner`.
NOTARIUS_OIDC_BOOTSTRAP_SUBJECT=11111111-1111-4111-8111-111111111111

# Graph-room application heartbeat interval (seconds). Revalidates membership
# when a post-commit room invalidation is lost. Set 0 to disable.
# NOTARIUS_GRAPH_ROOM_HEARTBEAT_SECONDS=15
# Ephemeral presence TTL (seconds) and best-effort update budget.
# NOTARIUS_GRAPH_ROOM_PRESENCE_TTL_SECONDS=5
# NOTARIUS_GRAPH_ROOM_PRESENCE_MAX_UPDATES_PER_SECOND=20
NOTARIUS_STORAGE_BACKEND=local
NOTARIUS_STORAGE_BUCKET=workbench-artifacts
# Local smoke without Prefect: inline. Compose production uses prefect.
NOTARIUS_EXECUTION_BACKEND=inline

# MCP is mounted at /mcp on the API process (stateless Streamable HTTP).
# Authenticate with a workspace-bound PAT in Authorization: Bearer <token>.
# Behind the same-origin gateway, public clients use https://<origin>/mcp
# (same authority as /api/v1). Do not set a process-global MCP API URL or
# workspace id; workspace comes only from the PAT.
# executions:run MCP tools are deferred; use browser/REST for shared runs.

# Set NOTARIUS_STORAGE_BACKEND=s3 for AWS S3 or an S3-compatible service such as MinIO.
# NOTARIUS_S3_ENDPOINT_URL=http://localhost:9000
# NOTARIUS_S3_REGION=us-east-1
# NOTARIUS_S3_ACCESS_KEY_ID=
# NOTARIUS_S3_SECRET_ACCESS_KEY=
# NOTARIUS_S3_FORCE_PATH_STYLE=true

PREFECT_API_URL=http://127.0.0.1:4200/api
